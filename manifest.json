{
  "manifest_version": 3,
  "name": "neet2leet",
  "version": "1.0.0",
  "description": "Adds an Open on LeetCode button to NeetCode problem pages.",
  "author": "Jaysinh Shukla",
  "homepage_url": "https://github.com/ultimatecoder/neet2leet",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://neetcode.io/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://neetcode.io/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "neet2leet@ultimatecoder",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
